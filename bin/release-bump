#!/usr/bin/env python3
"""Move tangier's version in every file that names it.

Usage: bin/release-bump <patch|minor|major|X.Y.Z>

Prints `version=X.Y.Z` and `previous=A.B.C` on stdout, in the form
`$GITHUB_OUTPUT` takes. Each file must name the current version exactly once,
or no file is changed. .github/workflows/release.yaml runs this.
"""

import os
import sys

from release_version import package_version, require_plain

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Each file, and how it names the version. `{}` is the version.
FILES = {
    "pyproject.toml": 'version = "{}"',
    "tangier/__init__.py": '__version__ = "{}"',
    "skills/tangier/reference/cli.md": "`tangier {}`",
    "skills/tangier/reference/github-actions.md": "`@v{}`",
}


def read(path: str) -> str:
    with open(os.path.join(ROOT, path)) as fh:
        return fh.read()


def next_version(current: str, bump: str) -> str:
    major, minor, patch = require_plain(current)
    if bump == "patch":
        return f"{major}.{minor}.{patch + 1}"
    if bump == "minor":
        return f"{major}.{minor + 1}.0"
    if bump == "major":
        return f"{major + 1}.0.0"
    if require_plain(bump) <= (major, minor, patch):
        sys.exit(f"error: {bump} is not above the current version {current}")
    return bump


def main(argv: list[str]) -> None:
    if len(argv) != 1:
        sys.exit("usage: bin/release-bump <patch|minor|major|X.Y.Z>")
    previous = package_version(read("pyproject.toml"), read("tangier/__init__.py"))
    version = next_version(previous, argv[0])

    rewritten = {}
    for path, pattern in FILES.items():
        text = read(path)
        old = pattern.format(previous)
        count = text.count(old)
        if count != 1:
            sys.exit(f"error: {path} names {old} {count} times, expected once")
        rewritten[path] = text.replace(old, pattern.format(version))
    for path, text in rewritten.items():
        with open(os.path.join(ROOT, path), "w") as fh:
            fh.write(text)

    print(f"version={version}")
    print(f"previous={previous}")


if __name__ == "__main__":
    main(sys.argv[1:])
