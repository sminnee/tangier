#!/usr/bin/env python3
"""Decide whether a commit on main releases its version.

Usage: bin/release-plan [<commit>]   (default HEAD; run inside the repo)

Prints `version=X.Y.Z`, `previous=A.B.C` and `release=true|false` on stdout,
in the form `$GITHUB_OUTPUT` takes, and the reason on stderr. `previous` is the
highest plain tagged version below this one, or empty: release notes start
there. The versions are read from the commit, not the working tree, so any
commit can be checked locally after `git fetch --tags`.

.github/workflows/prepare-release.yaml runs this on the version commit.
release.yaml runs it after CI passes on main, and again before it publishes.
"""

import subprocess
import sys
import tomllib

from release_version import package_version, parse, require_plain


def git(*args: str) -> str:
    result = subprocess.run(["git", *args], capture_output=True, text=True)
    if result.returncode != 0:
        sys.exit(result.stderr.strip())
    return result.stdout.strip()


def tagged_commit(tag: str) -> str | None:
    # `^{commit}` peels an annotated tag; a lightweight one resolves the same way.
    result = subprocess.run(
        ["git", "rev-parse", "-q", "--verify", f"refs/tags/{tag}^{{commit}}"], capture_output=True, text=True
    )
    return result.stdout.strip() if result.returncode == 0 else None


def parent_version(commit: str) -> str | None:
    """`pyproject.toml`'s version at the commit's first parent, or None when there is none to read."""
    result = subprocess.run(["git", "show", f"{commit}^:pyproject.toml"], capture_output=True, text=True)
    if result.returncode != 0:
        return None
    try:
        return tomllib.loads(result.stdout).get("project", {}).get("version")
    except tomllib.TOMLDecodeError:
        return None


def plan(version: str, previous: str, release: bool, reason: str) -> None:
    print(reason, file=sys.stderr)
    print(f"version={version}")
    print(f"previous={previous}")
    print(f"release={'true' if release else 'false'}")


def main(argv: list[str]) -> None:
    commit = git("rev-parse", "--verify", f"{argv[0] if argv else 'HEAD'}^{{commit}}")
    # The backstop before a tag: test_version.py holds these equal in CI.
    version = package_version(
        git("show", f"{commit}:pyproject.toml"), git("show", f"{commit}:tangier/__init__.py"), f" at {commit}"
    )
    key = require_plain(version)
    tag = f"v{version}"

    released = [(k, t[1:]) for t in git("tag", "-l", "v*.*.*").split() if (k := parse(t[1:]))]
    highest_key, highest = max(released, default=(None, None))
    previous = max(((k, v) for k, v in released if k < key), default=(None, ""))[1]

    tag_commit = tagged_commit(tag)
    if tag_commit and tag_commit != commit:
        plan(version, previous, False, f"{tag} tags {tag_commit}: the version is unchanged, nothing to release")
    elif tag_commit and key == highest_key:
        plan(version, previous, True, f"{tag} already tags {commit}: releasing again, after a partial failure")
    elif tag_commit:
        plan(version, previous, False, f"{tag} tags {commit} but v{highest} is newer: not releasing")
    # A later commit whose CI beat the version commit's would ship its unreviewed change.
    elif parent_version(commit) == version:
        plan(version, previous, False, f"{tag} is untagged, but {commit} did not move the version: not releasing")
    # Anything not above the highest release would move the alias backwards.
    elif highest_key is None or key > highest_key:
        plan(version, previous, True, f"{tag} is new and above v{highest or '<none>'}: releasing")
    else:
        # A superseded commit whose CI finished late, or a version bumped downwards.
        plan(version, previous, False, f"warning: {tag} is untagged but not above v{highest}: not releasing")


if __name__ == "__main__":
    main(sys.argv[1:])
